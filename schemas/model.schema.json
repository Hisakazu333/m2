{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M2 finite joint-kernel model, version 1",
  "description": "Syntactic schema. Model.validate additionally enforces vector lengths, state references and exact normalization.",
  "type": "object",
  "required": [
    "schema_version",
    "environments",
    "states",
    "actions",
    "kernels",
    "terminal",
    "prior",
    "initial_state",
    "horizon"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "environments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "labels"
        ],
        "properties": {
          "labels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                0,
                1
              ]
            }
          }
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    },
    "kernels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "state",
          "action",
          "outcomes"
        ],
        "properties": {
          "state": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "outcomes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "observation",
                "next_state",
                "probabilities",
                "task",
                "direct"
              ],
              "properties": {
                "observation": {
                  "type": "string"
                },
                "next_state": {
                  "type": "string"
                },
                "probabilities": {
                  "$ref": "#/$defs/vector"
                },
                "task": {
                  "$ref": "#/$defs/vector"
                },
                "direct": {
                  "$ref": "#/$defs/vector"
                }
              }
            }
          }
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "0",
          "1"
        ],
        "additionalProperties": {
          "$ref": "#/$defs/vector"
        }
      }
    },
    "prior": {
      "$ref": "#/$defs/vector"
    },
    "initial_state": {
      "type": "string"
    },
    "horizon": {
      "type": "integer",
      "minimum": 0
    },
    "metadata": {
      "type": "object"
    }
  },
  "$defs": {
    "rational": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^(?:[0-9]+/[1-9][0-9]*|[0-9]+(?:\\.[0-9]+)?)$"
        }
      ]
    },
    "vector": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rational"
      }
    }
  }
}
